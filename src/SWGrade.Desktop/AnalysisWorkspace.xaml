<UserControl x:Class="SWGrade.Desktop.AnalysisWorkspace"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SWGrade.Desktop">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhenTrue"/>
        <DataTemplate x:Key="PartSelector">
            <StackPanel>
                <Border Background="{DynamicResource SurfaceAlt}" CornerRadius="8" Padding="12" Margin="0,0,0,12" MinHeight="75">
                    <StackPanel>
                        <TextBlock Text="{Binding FileName}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"
                                   ToolTip="{Binding SourcePath}"/>
                        <TextBlock Text="{Binding SourceDetail}" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Muted}"/>
                    </StackPanel>
                </Border>
                <Button Content="从已打开零件选择…" Command="{Binding OpenCommand}" Margin="0,0,0,8" HorizontalAlignment="Stretch"/>
                <Button Content="使用 CAD 当前零件" Command="{Binding ActiveCommand}" Margin="0,0,0,8" HorizontalAlignment="Stretch"/>
                <Button Content="选择 .SLDPRT 文件…" Command="{Binding BrowseCommand}" Margin="0,0,0,10" HorizontalAlignment="Stretch"/>
                <Label Content="配置名（留空使用活动配置）" Target="{Binding ElementName=Config}" Padding="0,0,0,4"/>
                <TextBox x:Name="Config" Text="{Binding Configuration, UpdateSourceTrigger=PropertyChanged}" Padding="7,5"
                         AutomationProperties.Name="配置名称"/>
                <Button Content="清除选择" Command="{Binding ClearCommand}" HorizontalAlignment="Left" Margin="0,9,0,0"/>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="PropertyRow">
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="96"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,0,8,0"/>
                <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap"/>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="ConfigurationSummary">
            <Expander IsExpanded="{Binding IsPrimary, Mode=OneTime}" Margin="0,0,0,8">
                <Expander.Header>
                    <StackPanel>
                        <TextBlock Text="{Binding Role}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Configuration}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Expander.Header>
                <StackPanel Margin="0,9,0,0">
                    <TextBlock Text="{Binding FileName}" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <ItemsControl ItemsSource="{Binding Fields}" ItemTemplate="{StaticResource PropertyRow}"/>
                </StackPanel>
            </Expander>
        </DataTemplate>
        <DataTemplate x:Key="FeatureDisplay">
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto" MinWidth="74"/>
                    <ColumnDefinition Width="Auto" MinWidth="74"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Name}" ToolTip="{Binding Code}" TextWrapping="Wrap" Margin="0,0,10,0"/>
                <TextBlock Text="{Binding Current}" Grid.Column="1" Margin="0,0,10,0" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Reference}" Grid.Column="2" TextWrapping="Wrap"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="28,20,28,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowResult}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="模型分析" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="从 SOLIDWORKS 或磁盘选择零件，查看模型数据和对照结果。" Style="{StaticResource Description}"/>
            </StackPanel>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="1100" Margin="0,22,0,12" VerticalAlignment="Center" IsEnabled="{Binding CanEdit}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="86"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Panel}">
                            <StackPanel>
                                <TextBlock Text="参考件" Style="{StaticResource SectionTitle}"/>
                                <ContentControl Content="{Binding Reference}" ContentTemplate="{StaticResource PartSelector}"/>
                            </StackPanel>
                        </Border>
                        <Button Grid.Column="1" Content="⇄ 互换" Command="{Binding SwapCommand}" HorizontalAlignment="Center"
                                Margin="0" AutomationProperties.Name="交换参考件与当前件"/>
                        <Border Grid.Column="2" Style="{StaticResource Panel}">
                            <StackPanel>
                                <TextBlock Text="当前件" Style="{StaticResource SectionTitle}"/>
                                <ContentControl Content="{Binding Current}" ContentTemplate="{StaticResource PartSelector}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <WrapPanel HorizontalAlignment="Center" Margin="0,16,0,0">
                        <Label Content="零件类型" Target="{Binding ElementName=SheetMetalMode}" Padding="0,5,9,5"/>
                        <ComboBox x:Name="SheetMetalMode" MinWidth="175"
                                  ItemsSource="{Binding SheetMetalOptions}" DisplayMemberPath="Label" SelectedValuePath="Mode"
                                  SelectedValue="{Binding SheetMetal, Mode=TwoWay}"/>
                    </WrapPanel>
                    <StackPanel HorizontalAlignment="Center" Margin="0,20,0,0">
                        <TextBlock Text="选择两件可对照，仅选当前件可单独分析。" Foreground="{DynamicResource Muted}"
                                   Margin="0,0,0,10" TextAlignment="Center" TextWrapping="Wrap"/>
                        <Button Content="{Binding AnalyzeLabel}" Command="{Binding AnalyzeCommand}"
                                Style="{StaticResource PrimaryButton}" MinWidth="230" Margin="0"
                                HorizontalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowResult}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,14">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="复制 JSON" Command="{Binding CopyCommand}"/>
                    <Button Content="导出 JSON…" Command="{Binding ExportCommand}" Margin="0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Content="← 重新选件" Command="{Binding BackCommand}" Margin="0,0,12,0"/>
                    <TextBlock Text="{Binding ResultTitle}" Style="{StaticResource PageTitle}"/>
                </StackPanel>
            </DockPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4*" MinWidth="208"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="8*"/>
                </Grid.ColumnDefinitions>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,4,0">
                        <Border Style="{StaticResource Panel}" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="零件信息" Style="{StaticResource SectionTitle}"/>
                                <ContentControl Content="{Binding CurrentSummary}" ContentTemplate="{StaticResource ConfigurationSummary}"/>
                                <ContentControl Content="{Binding ReferenceSummary}" ContentTemplate="{StaticResource ConfigurationSummary}">
                                    <ContentControl.Style>
                                        <Style TargetType="ContentControl">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Content, RelativeSource={RelativeSource Self}}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ContentControl.Style>
                                </ContentControl>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Panel}" Padding="14">
                            <StackPanel>
                                <TextBlock Text="需要关注" Style="{StaticResource SectionTitle}"/>
                                <ItemsControl x:Name="FindingItems" ItemsSource="{Binding Findings}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,9">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Description}"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="没有需要立即处理的提示。" TextWrapping="Wrap" Foreground="{DynamicResource Muted}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasItems, ElementName=FindingItems}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                <Border Grid.Column="2" Style="{StaticResource Panel}" Padding="12">
                    <TabControl Padding="7" SelectedIndex="{Binding ResultTab, Mode=TwoWay}">
                        <TabItem Header="{Binding FoldedTabTitle}">
                            <local:PartViewport Scene="{Binding Scene}"/>
                        </TabItem>
                        <TabItem Header="展开图" Visibility="{Binding ShowSheetMetal, Converter={StaticResource VisibleWhenTrue}}">
                            <local:PartViewport IsFlatPattern="True" Scene="{Binding Scene}"/>
                        </TabItem>
                        <TabItem Header="参数对照">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="3,0,6,0">
                                    <TextBlock Text="用默认容差对照两件的参数。按作业容差计分可切换到「评分试算」。"
                                               Style="{StaticResource Description}" Margin="0,0,0,12"/>
                                    <ItemsControl x:Name="ParameterItems" ItemsSource="{Binding ParameterRows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,10">
                                                    <StackPanel>
                                                        <WrapPanel>
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="0,0,12,0"/>
                                                            <TextBlock Text="{Binding Conclusion}" Foreground="{DynamicResource Accent}"/>
                                                        </WrapPanel>
                                                        <TextBlock Text="{Binding Measurements}" Style="{StaticResource Description}"/>
                                                        <TextBlock Text="{Binding Reason}" Style="{StaticResource Description}"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="加选一个参考件后，可在这里查看参数差异。" TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasItems, ElementName=ParameterItems}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="建模特征">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="3,0,6,0">
                                    <TextBlock Text="{Binding FeatureNote}" Style="{StaticResource Description}" Margin="0,0,0,12"/>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto" MinWidth="74"/>
                                            <ColumnDefinition Width="Auto" MinWidth="74"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="常用建模特征" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Column="1" Text="当前件" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="2" Text="参考件" FontWeight="SemiBold"/>
                                    </Grid>
                                    <ItemsControl x:Name="KeyFeatureItems" ItemsSource="{Binding KeyFeatures}" ItemTemplate="{StaticResource FeatureDisplay}"/>
                                    <TextBlock Text="未读取到清单中的常用建模特征，可展开全部类型查看。" TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasItems, ElementName=KeyFeatureItems}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Expander Header="全部类型及作业规则用名" Margin="0,12,0,0">
                                        <DataGrid ItemsSource="{Binding AllFeatures}" AutoGenerateColumns="False" IsReadOnly="True"
                                                  CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="规则用名" Binding="{Binding Code}" Width="*" ElementStyle="{StaticResource TableCellText}"/>
                                                <DataGridTextColumn Header="当前件" Binding="{Binding Current}" Width="74" ElementStyle="{StaticResource TableCellText}"/>
                                                <DataGridTextColumn Header="参考件" Binding="{Binding Reference}" Width="74" ElementStyle="{StaticResource TableCellText}"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Expander>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="评分试算">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="3,0,6,0">
                                    <Label Content="评分作业" Target="{Binding ElementName=ScoringAssignment}" Padding="0,0,0,5"/>
                                    <ComboBox x:Name="ScoringAssignment" ItemsSource="{Binding Assignments}" SelectedItem="{Binding SelectedAssignment}"
                                              DisplayMemberPath="Name" AutomationProperties.Name="评分作业"/>
                                    <TextBlock Text="{Binding TrialMessage}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,12,0,12"/>
                                    <ItemsControl ItemsSource="{Binding TrialChecks}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,10">
                                                    <StackPanel>
                                                        <WrapPanel>
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="0,0,12,0" TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding Score}" Foreground="{DynamicResource Accent}"/>
                                                        </WrapPanel>
                                                        <TextBlock Text="{Binding Measurements}" Style="{StaticResource Description}"/>
                                                        <TextBlock Text="{Binding Reason}" Style="{StaticResource Description}"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </Border>
            </Grid>
        </Grid>

        <StackPanel Grid.Row="1" Margin="0,10,0,0"
                    Visibility="{Binding IsBusy, Converter={StaticResource VisibleWhenTrue}}">
            <TextBlock Text="{Binding Activity}" Style="{StaticResource Description}" Margin="0"/>
            <ProgressBar Height="3" Margin="0,5,0,0" IsIndeterminate="True"/>
        </StackPanel>
    </Grid>
</UserControl>
