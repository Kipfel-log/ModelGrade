<UserControl x:Class="SWGrade.Desktop.PartViewport"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,10">
            <WrapPanel>
                <Button x:Name="OverlayButton" Content="完整叠加" Click="ShowOverlay"/>
                <Button x:Name="CurrentButton" Content="当前件" Click="ShowCurrent"/>
                <Button x:Name="ReferenceButton" Content="参考件" Click="ShowReference"/>
                <Button x:Name="ResetButton" Content="重置视角" Click="ResetView"/>
                <ComboBox x:Name="StandardViews" AutomationProperties.Name="标准视图" MinWidth="100"
                          Loaded="InitializeStandardViews" SelectionChanged="SelectStandardView">
                    <ComboBoxItem Content="标准视图" IsEnabled="False"/>
                    <ComboBoxItem Content="正视"/>
                    <ComboBoxItem Content="俯视"/>
                    <ComboBoxItem Content="侧视"/>
                    <ComboBoxItem Content="等轴测"/>
                </ComboBox>
            </WrapPanel>
            <WrapPanel x:Name="DifferenceControls" Margin="0,6,0,0">
                <WrapPanel x:Name="SolidControls" Visibility="Collapsed">
                    <Button x:Name="ExtraButton" Content="仅多余" Click="ShowExtra"/>
                    <Button x:Name="MissingButton" Content="仅缺少" Click="ShowMissing"/>
                    <CheckBox x:Name="TransparentReference" Content="透明参考件" Click="ToggleShared"
                              Margin="0,0,9,0" VerticalAlignment="Center"/>
                    <Slider x:Name="ReferenceOpacity" Width="78" Minimum="0.1" Maximum="0.75" Value="0.25"
                            Margin="0,0,9,0" VerticalAlignment="Center" ToolTip="参考件不透明度"
                            AutomationProperties.Name="参考件不透明度" ValueChanged="ChangeReferenceOpacity"/>
                </WrapPanel>
                <CheckBox x:Name="DifferencesOnly" Content="仅看差异" Click="ToggleShared" VerticalAlignment="Center"/>
            </WrapPanel>
            <WrapPanel x:Name="DeviationControls" Visibility="Collapsed" Margin="0,6,0,0">
                <Label Content="容差 mm" Target="{Binding ElementName=DeviationTolerance}" Padding="0,4,6,4"/>
                <TextBox x:Name="DeviationTolerance" MinWidth="63" Margin="0,0,9,0" AutomationProperties.Name="偏差容差毫米"/>
                <Label Content="范围 ±mm" Target="{Binding ElementName=DeviationRange}" Padding="0,4,6,4"/>
                <TextBox x:Name="DeviationRange" MinWidth="63" Margin="0,0,9,0" AutomationProperties.Name="色带范围毫米"/>
                <Button Content="应用色带" Click="ApplyDeviationScale" Margin="0" MinHeight="32"/>
            </WrapPanel>
        </StackPanel>
        <Border x:Name="Surface" Grid.Row="1" BorderThickness="1" BorderBrush="{DynamicResource Line}"
                Background="{DynamicResource ViewportSurface}" CornerRadius="6" ClipToBounds="True"
                MouseDown="BeginMove" MouseUp="EndMove" MouseMove="Move" MouseWheel="Zoom"
                LostMouseCapture="CancelMove" SizeChanged="Resize">
            <Grid>
                <Viewport3D x:Name="ModelViewport" ClipToBounds="True">
                    <Viewport3D.Camera>
                        <OrthographicCamera x:Name="ViewCamera" Position="0,0,8" LookDirection="0,0,-8"
                                            UpDirection="0,1,0" Width="4" NearPlaneDistance=".01" FarPlaneDistance="40"/>
                    </Viewport3D.Camera>
                    <ModelVisual3D>
                        <ModelVisual3D.Content>
                            <Model3DGroup>
                                <AmbientLight Color="#838D99"/>
                                <DirectionalLight Color="#FFFFFF" Direction="-0.6,-0.8,-1"/>
                                <DirectionalLight Color="#9BADBE" Direction="0.8,0.2,1"/>
                            </Model3DGroup>
                        </ModelVisual3D.Content>
                    </ModelVisual3D>
                    <ModelVisual3D x:Name="PartVisual"/>
                </Viewport3D>
                <TextBlock x:Name="EmptyMessage" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextAlignment="Center" Padding="22" Foreground="{DynamicResource Muted}" IsHitTestVisible="False"/>
            </Grid>
        </Border>
        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <TextBlock x:Name="VisibleName" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <WrapPanel x:Name="Legend" Margin="0,6,0,0">
                <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                    <Ellipse Width="10" Height="10" Fill="#8E9BA4" Margin="0,0,6,0"/>
                    <TextBlock Text="重叠"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                    <Ellipse Width="10" Height="10" Fill="#BA382F" Margin="0,0,6,0"/>
                    <TextBlock Text="学生件多余"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="10" Height="10" Fill="#2567BC" Margin="0,0,6,0"/>
                    <TextBlock Text="学生件缺少"/>
                </StackPanel>
            </WrapPanel>
            <StackPanel x:Name="DeviationLegend" Visibility="Collapsed" Margin="0,6,0,0">
                <Border x:Name="DeviationColorBar" Height="10" CornerRadius="3"/>
                <DockPanel Margin="0,2,0,0">
                    <TextBlock x:Name="NegativeLimit" DockPanel.Dock="Left"/>
                    <TextBlock x:Name="PositiveLimit" DockPanel.Dock="Right"/>
                    <TextBlock x:Name="ToleranceBand" TextAlignment="Center"/>
                </DockPanel>
                <TextBlock x:Name="LocalDeviation" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,4,0,0"/>
            </StackPanel>
            <TextBlock x:Name="GeometryNotice" Foreground="{DynamicResource Muted}" FontSize="13"
                       Margin="0,5,0,0" TextWrapping="Wrap"/>
            <TextBlock Text="左键旋转 · 右键平移 · 滚轮缩放" Foreground="{DynamicResource Muted}"
                       Margin="0,5,0,0" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</UserControl>
