<UserControl x:Class="SWGrade.Desktop.PartViewport"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <WrapPanel Margin="0,0,0,10">
            <Button x:Name="OverlayButton" Content="叠加差异" Click="ShowOverlay"/>
            <Button x:Name="CurrentButton" Content="当前件" Click="ShowCurrent"/>
            <Button x:Name="ReferenceButton" Content="参考件" Click="ShowReference"/>
            <Button x:Name="ResetButton" Content="重置视角" Click="ResetView"/>
            <CheckBox x:Name="DifferencesOnly" Content="仅看差异" Click="ToggleShared" VerticalAlignment="Center"/>
        </WrapPanel>
        <Border x:Name="Surface" Grid.Row="1" BorderThickness="1" BorderBrush="{DynamicResource Line}"
                Background="{DynamicResource ViewportSurface}" CornerRadius="6" ClipToBounds="True"
                MouseDown="BeginMove" MouseUp="EndMove" MouseMove="Move" MouseWheel="Zoom"
                LostMouseCapture="CancelMove" SizeChanged="Resize">
            <Grid>
                <Viewport3D ClipToBounds="True">
                    <Viewport3D.Camera>
                        <OrthographicCamera x:Name="ViewCamera" Position="0,0,8" LookDirection="0,0,-8"
                                            UpDirection="0,1,0" Width="4" NearPlaneDistance=".01" FarPlaneDistance="40"/>
                    </Viewport3D.Camera>
                    <ModelVisual3D>
                        <ModelVisual3D.Content>
                            <Model3DGroup>
                                <AmbientLight Color="#838D99"/>
                                <DirectionalLight Color="#FFFFFF" Direction="-0.6,-0.8,-1"/>
                                <DirectionalLight Color="#9BADBE" Direction="0.8,0.2,1"/>
                            </Model3DGroup>
                        </ModelVisual3D.Content>
                    </ModelVisual3D>
                    <ModelVisual3D x:Name="PartVisual"/>
                </Viewport3D>
                <TextBlock x:Name="EmptyMessage" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextAlignment="Center" Padding="22" Foreground="{DynamicResource Muted}" IsHitTestVisible="False"/>
            </Grid>
        </Border>
        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <TextBlock x:Name="VisibleName" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <WrapPanel x:Name="Legend" Margin="0,6,0,0">
                <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                    <Ellipse Width="10" Height="10" Fill="#8E9BA4" Margin="0,0,6,0"/>
                    <TextBlock Text="重叠"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                    <Ellipse Width="10" Height="10" Fill="#2E6CB6" Margin="0,0,6,0"/>
                    <TextBlock Text="当前件有差异"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="10" Height="10" Fill="#C86423" Margin="0,0,6,0"/>
                    <TextBlock Text="参考件有差异"/>
                </StackPanel>
            </WrapPanel>
            <TextBlock x:Name="GeometryNotice" Foreground="{DynamicResource Muted}" FontSize="13"
                       Margin="0,5,0,0" TextWrapping="Wrap"/>
            <TextBlock Text="左键旋转 · 右键平移 · 滚轮缩放" Foreground="{DynamicResource Muted}"
                       Margin="0,5,0,0" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</UserControl>
