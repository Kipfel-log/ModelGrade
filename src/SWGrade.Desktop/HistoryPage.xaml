<UserControl x:Class="SWGrade.Desktop.HistoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Available"/>
    </UserControl.Resources>
    <Grid Margin="28,20,28,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,18">
            <Button DockPanel.Dock="Right" Content="刷新" Command="{Binding RefreshCommand}" Margin="8,0,0,0" VerticalAlignment="Top"/>
            <StackPanel>
                <TextBlock Text="批改记录" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="查看各作业的历史提交、批改状态和终评。" Style="{StaticResource Description}"/>
            </StackPanel>
        </DockPanel>
        <Border Grid.Row="1" Style="{StaticResource Panel}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="本机记录暂不可用，可以重新读取。"
                           Style="{StaticResource Description}" Margin="0,0,0,12"
                           Visibility="{Binding HasError, Converter={StaticResource Available}}"/>
                <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" Height="4" Margin="0,0,0,12"
                             Visibility="{Binding IsLoading, Converter={StaticResource Available}}"/>
                <StackPanel DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="0,14,0,0">
                    <Button Content="打开所选结果" Command="{Binding OpenCommand}" Style="{StaticResource PrimaryButton}" Margin="0"/>
                </StackPanel>
                <Grid>
                    <DataGrid ItemsSource="{Binding Entries}" SelectedItem="{Binding Selected}" Visibility="{Binding HasEntries, Converter={StaticResource Available}}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" MinRowHeight="42"
                              AlternatingRowBackground="{DynamicResource SurfaceAlt}">
                        <DataGrid.Columns>
                            <DataGridTextColumn ElementStyle="{StaticResource TableCellText}" Header="文件" Binding="{Binding FileName}" Width="2*" MinWidth="130"/>
                            <DataGridTextColumn ElementStyle="{StaticResource TableCellText}" Header="作业" Binding="{Binding AssignmentName}" Width="*" MinWidth="105"/>
                            <DataGridTextColumn ElementStyle="{StaticResource TableCellText}" Header="状态" Binding="{Binding Status}" Width="100"/>
                            <DataGridTextColumn ElementStyle="{StaticResource TableCellText}" Header="终评" Binding="{Binding Score}" Width="70"/>
                            <DataGridTextColumn ElementStyle="{StaticResource TableCellText}" Header="更新时间" Binding="{Binding DisplayTime}" Width="125"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Visibility="{Binding IsEmpty, Converter={StaticResource Available}}" HorizontalAlignment="Center"
                                VerticalAlignment="Center" Margin="18">
                        <ui:SymbolIcon Symbol="ClipboardClock24" FontSize="30" Foreground="{DynamicResource Accent}"/>
                        <TextBlock Text="尚无批改记录" Style="{StaticResource SectionTitle}" TextAlignment="Center" Margin="0,10,0,2"/>
                        <TextBlock Text="作业开始批改后，任务会显示在这里。" Style="{StaticResource Description}" TextAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
