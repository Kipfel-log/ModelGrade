<ui:FluentWindow x:Class="SWGrade.Desktop.OpenPartPicker"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  Title="选择 SOLIDWORKS 零件" Width="820" Height="440" MinWidth="560" MinHeight="300"
                  WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ExtendsContentIntoTitleBar="True"
                  WindowBackdropType="None" WindowCornerPreference="Round"
                  FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="15"
                  Background="{DynamicResource Canvas}" Foreground="{DynamicResource Ink}"
                  TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="38"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ui:TitleBar Title="" Icon="{x:Null}" ShowMinimize="False" ShowMaximize="False"
                     CanMaximize="False" Background="Transparent" Height="38"
                     ButtonsForeground="{DynamicResource Ink}"/>
        <Grid Grid.Row="1" Margin="24,5,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,14">
                <TextBlock Text="已打开的 SOLIDWORKS 零件" Style="{StaticResource PageTitle}" FontSize="23"/>
                <TextBlock Text="本次使用所选零件的已保存版本。" Style="{StaticResource Description}"/>
            </StackPanel>
            <DataGrid Grid.Row="1" x:Name="Parts" AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" CanUserAddRows="False" CanUserDeleteRows="False"
                      SelectionMode="Single" GridLinesVisibility="Horizontal" MinRowHeight="38"
                      AlternatingRowBackground="{DynamicResource SurfaceAlt}" AutomationProperties.Name="已打开的 SOLIDWORKS 零件">
                <DataGrid.Columns>
                    <DataGridTextColumn ElementStyle="{StaticResource TableCellText}" Header="零件" Binding="{Binding Title}" Width="130"/>
                    <DataGridTextColumn ElementStyle="{StaticResource TableCellText}" Header="活动配置" Binding="{Binding Configuration}" Width="112"/>
                    <DataGridTextColumn ElementStyle="{StaticResource TableCellText}" Header="保存状态" Binding="{Binding SavedState}" Width="132"/>
                    <DataGridTextColumn ElementStyle="{StaticResource TableCellText}" Header="路径" Binding="{Binding Path}" Width="*" MinWidth="135"/>
                </DataGrid.Columns>
            </DataGrid>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="使用所选零件" IsDefault="True" Click="Choose" Style="{StaticResource PrimaryButton}"
                        IsEnabled="{Binding SelectedItem.CanRead, ElementName=Parts, FallbackValue=False}"/>
                <Button Content="取消" IsCancel="True" Margin="0"/>
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
