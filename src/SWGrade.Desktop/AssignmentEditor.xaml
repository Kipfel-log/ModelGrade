<UserControl x:Class="SWGrade.Desktop.AssignmentEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="WhenTrue"/>
        <Style x:Key="EditorCard" TargetType="Border" BasedOn="{StaticResource Panel}">
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
        <Style x:Key="HelpText" TargetType="TextBlock" BasedOn="{StaticResource Description}">
            <Setter Property="Margin" Value="0,5,0,10"/>
        </Style>
        <DataTemplate x:Key="NumberSlider">
            <StackPanel MaxWidth="510" Margin="0,0,0,12">
                <TextBlock Text="{Binding Label}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Slider Minimum="0" Maximum="{Binding SliderMaximum}" Value="{Binding SliderValue, Mode=TwoWay}"
                            SmallChange="{Binding SliderStep}" LargeChange="{Binding SliderStep}"
                            VerticalAlignment="Center" Margin="0,0,14,0" AutomationProperties.Name="{Binding Label}"/>
                    <TextBox Grid.Column="1" MinWidth="84" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="{Binding Label}" VerticalContentAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding Unit}" Margin="7,0,0,0" VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="Tolerance">
            <StackPanel Margin="0,0,0,10">
                <ContentControl Content="{Binding Relative}" ContentTemplate="{StaticResource NumberSlider}"/>
                <TextBlock Text="{Binding Example}" Style="{StaticResource HelpText}" Margin="0,0,0,8"/>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="AbsoluteTolerance">
            <StackPanel Margin="0,0,0,12">
                <TextBlock Text="{Binding Label}" TextWrapping="Wrap" Margin="0,0,0,5"/>
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Unit}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding Label}"/>
                </DockPanel>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel IsEnabled="{Binding CanEdit}" MaxWidth="850" Margin="0,0,6,0">
                <Border Style="{StaticResource EditorCard}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="作业与标准件" Style="{StaticResource SectionTitle}"/>
                        <Label Content="作业名称" Target="{Binding ElementName=AssignmentName}" Padding="0,0,0,5"/>
                        <TextBox x:Name="AssignmentName" Text="{Binding Draft.Name, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.AutomationId="AssignmentName" Margin="0,0,0,12"/>
                        <TextBlock Text="{Binding Draft.StandardFileName}" ToolTip="{Binding Draft.StandardPath}"
                                   FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,6"/>
                        <WrapPanel>
                            <Button Content="选择标准件…" Command="{Binding ChooseStandardCommand}"/>
                            <Button Content="从 SOLIDWORKS 选择…" Command="{Binding ChooseOpenStandardCommand}"/>
                        </WrapPanel>
                        <TextBlock Text="{Binding Draft.StandardConfigurationSummary}" Style="{StaticResource HelpText}"/>
                        <StackPanel Visibility="{Binding Draft.HasMultipleConfigurations, Converter={StaticResource WhenTrue}}">
                            <Label Content="改用其他配置" Target="{Binding ElementName=ReferenceChoice}" Padding="0,0,0,5"/>
                            <ComboBox x:Name="ReferenceChoice" AutomationProperties.AutomationId="StandardConfigurationChoice"
                                      ItemsSource="{Binding Draft.ConfigurationChoices}" DisplayMemberPath="Display" SelectedValuePath="Name"
                                      SelectedValue="{Binding Draft.StandardConfiguration, Mode=TwoWay}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource EditorCard}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="评分方式" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="默认比较零件的体积、表面积与实体。需要考查建模步骤时，勾选下面一项。"
                                   Style="{StaticResource HelpText}"/>
                        <CheckBox Content="还要检查指定建模操作" IsChecked="{Binding Draft.CheckProcess}"
                                  AutomationProperties.AutomationId="CheckRequiredOperations" Margin="0,2,0,8"/>
                        <StackPanel Margin="0,4,0,12"
                                    Visibility="{Binding Draft.CheckProcess, Converter={StaticResource WhenTrue}}">
                            <TextBlock Text="请选择学生必须使用的操作，至少选一项。" Style="{StaticResource HelpText}"/>
                            <ItemsControl ItemsSource="{Binding Draft.FeatureChoices}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Label}" IsChecked="{Binding Selected}" Margin="0,0,18,8"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="其他操作可在高级设置中填写。" Style="{StaticResource HelpText}"/>
                        </StackPanel>
                        <WrapPanel Margin="0,4,0,0">
                            <Label Content="误差要求" Target="{Binding ElementName=TolerancePreset}" Padding="0,6,10,6"/>
                            <ComboBox x:Name="TolerancePreset" AutomationProperties.AutomationId="TolerancePreset" MinWidth="132"
                                      ItemsSource="{Binding Draft.Presets}" SelectedItem="{Binding Draft.Preset}"
                                      ToolTip="标准档适合先试用。各项目的具体允许误差可在高级设置调整。"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource EditorCard}" Padding="16">
                    <Expander Header="高级设置" AutomationProperties.AutomationId="AdvancedAssignmentRules" IsExpanded="False">
                        <StackPanel Margin="0,14,0,0">
                            <Label Content="零件类型" Target="{Binding ElementName=AssignmentPartType}" Padding="0,0,0,5"/>
                            <ComboBox x:Name="AssignmentPartType" ItemsSource="{Binding SheetMetalOptions}" DisplayMemberPath="Label"
                                      SelectedValuePath="Mode" SelectedValue="{Binding Draft.SheetMetal, Mode=TwoWay}"/>
                            <TextBlock Text="自动识别时，若标准件是钣金，几何评分会同时检查折弯态和展开图。也可手动指定。"
                                       Style="{StaticResource HelpText}"/>
                            <TextBlock Text="评分权重" Style="{StaticResource SectionTitle}"/>
                            <ContentControl Content="{Binding Draft.Geometry}" ContentTemplate="{StaticResource NumberSlider}"/>
                            <ContentControl Content="{Binding Draft.Parameters}" ContentTemplate="{StaticResource NumberSlider}"/>
                            <ContentControl Content="{Binding Draft.Features}" ContentTemplate="{StaticResource NumberSlider}"/>
                            <TextBlock Text="{Binding Draft.WeightTotal}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Draft.WeightNotice}" Style="{StaticResource HelpText}"
                                       Visibility="{Binding Draft.HasUnavailableWeights, Converter={StaticResource WhenTrue}}"/>
                            <Button Content="{Binding Draft.RedistributeLabel}" Command="{Binding RedistributeWeightsCommand}"
                                    HorizontalAlignment="Left" Margin="0,0,0,16"/>

                            <TextBlock Text="详细误差设置" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="严格 0.01%、标准 0.1%、宽松 0.5% 是建议初始值。可按题目修改每项允许偏差。"
                                       Style="{StaticResource HelpText}"/>
                            <ContentControl Content="{Binding Draft.Volume}" ContentTemplate="{StaticResource Tolerance}"/>
                            <ContentControl Content="{Binding Draft.Area}" ContentTemplate="{StaticResource Tolerance}"/>
                            <ContentControl Content="{Binding Draft.Mass}" ContentTemplate="{StaticResource Tolerance}"
                                            Visibility="{Binding Draft.CheckMass, Converter={StaticResource WhenTrue}}"/>

                            <TextBlock Text="额外检查" Style="{StaticResource SectionTitle}"/>
                            <CheckBox Content="要求模型只有一个实体" IsChecked="{Binding Draft.RequireSingleSolidBody}" Margin="0,0,0,8"
                                      ToolTip="需要多个独立实体的题目，可取消此项。"/>
                            <CheckBox Content="检查质量" IsChecked="{Binding Draft.CheckMass}" Margin="0,0,0,8"
                                      ToolTip="题目有质量要求时使用。无法可靠读取质量时，该项待复核。"/>
                            <CheckBox Content="检查材料" IsChecked="{Binding Draft.CheckMaterial}" Margin="0,0,0,16"
                                      ToolTip="核对学生零件的材料是否与标准件一致。"/>

                            <TextBlock Text="{Binding Draft.ConfigurationStatus}" Style="{StaticResource HelpText}"/>
                            <Button Content="重新读取标准件配置" Command="{Binding RefreshConfigurationsCommand}"
                                    HorizontalAlignment="Left" Margin="0,0,0,14"/>
                            <TextBlock Text="学生模型配置匹配" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="通常使用与标准模型同名的版本。如果全班约定了另一个名字，可在这里输入。个别学生不匹配时，在结果区单独选择。"
                                       Style="{StaticResource HelpText}"/>
                            <Label Content="全班约定的学生配置名（可留空）" Target="{Binding ElementName=StudentConfig}" Padding="0,0,0,5"/>
                            <TextBox x:Name="StudentConfig" Text="{Binding Draft.StudentConfiguration, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,18" ToolTip="这是学生文件中保存的版本名。留空使用标准模型的配置名称。"/>

                            <TextBlock Text="绝对容差" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="批改时比较「实际误差」与「允许误差」。允许误差取两个数中较大的一个：标准值乘百分比、下方填写的绝对容差。等于上限也通过。"
                                       Style="{StaticResource HelpText}"/>
                            <ContentControl Content="{Binding Draft.Volume.Absolute}" ContentTemplate="{StaticResource AbsoluteTolerance}"/>
                            <ContentControl Content="{Binding Draft.Area.Absolute}" ContentTemplate="{StaticResource AbsoluteTolerance}"/>
                            <ContentControl Content="{Binding Draft.Mass.Absolute}" ContentTemplate="{StaticResource AbsoluteTolerance}"
                                            Visibility="{Binding Draft.CheckMass, Converter={StaticResource WhenTrue}}"/>

                            <TextBlock Text="几何与特征规则" Style="{StaticResource SectionTitle}" Margin="0,9,0,9"/>
                            <TextBlock Text="不同文件内容的形状差异由教师复核。可为有可靠证据的比较预先设置计分规则。"
                                       Style="{StaticResource HelpText}"/>
                            <Label Content="几何评分策略" Target="{Binding ElementName=GeometryStrategy}" Padding="0,0,0,5"/>
                            <ComboBox x:Name="GeometryStrategy" ItemsSource="{Binding GeometryPolicies}" SelectedItem="{Binding Draft.GeometryPolicy}"
                                      Margin="0,0,0,9"/>
                            <Label Content="几何差异率容差（%）" Target="{Binding ElementName=GeometryThreshold}" Padding="0,0,0,5"/>
                            <TextBox x:Name="GeometryThreshold" Text="{Binding Draft.GeometryTolerancePercent, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,10" ToolTip="超过该差异率时几何不通过。等实际几何比较接入后用于自动计算。"/>
                            <Label Content="分档规则（仅在选择分档时生效）" Target="{Binding ElementName=GeometryBands}" Padding="0,0,0,5"/>
                            <TextBox x:Name="GeometryBands" Text="{Binding Draft.Bands, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" MinLines="2" TextWrapping="Wrap" Margin="0,0,0,3"/>
                            <TextBlock Text="每行填写「差异率上限 给分百分比」，按上限从小到大排列。例如 0.1 100。"
                                       Style="{StaticResource HelpText}"/>
                            <Label Content="其他建模操作及规则用名" Target="{Binding ElementName=FeatureList}" Padding="0,0,0,5"/>
                            <TextBox x:Name="FeatureList" Text="{Binding Draft.FeatureTypes, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" MinLines="2" TextWrapping="Wrap" Margin="0,0,0,3"/>
                            <TextBlock Text="每行填一个特征类型，可从模型分析的「建模特征」页展开「全部类型及作业规则用名」查看名称。规则用名与上方的常用操作选择同步。"
                                       Style="{StaticResource HelpText}"/>
                            <Label Content="指定 SOLIDWORKS 版本" Target="{Binding ElementName=ExpectedCad}" Padding="0,2,0,5"/>
                            <ComboBox x:Name="ExpectedCad" ItemsSource="{Binding CadYears}" SelectedItem="{Binding Draft.CadYear}"/>
                        </StackPanel>
                    </Expander>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="1" Style="{StaticResource Panel}" Padding="12,8" MaxWidth="850" Margin="0,8,6,0">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Content="{Binding Draft.SaveLabel}" Command="{Binding SaveAssignmentCommand}"
                        AutomationProperties.AutomationId="SaveAssignment" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"/>
                <TextBlock Text="{Binding Draft.ReviewSummary}" Style="{StaticResource Description}" VerticalAlignment="Center" Margin="0"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
