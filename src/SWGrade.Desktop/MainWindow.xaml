<Window x:Class="SWGrade.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:SWGrade.Desktop"
        Title="SWGrade" Icon="Assets/SWGrade.ico" Width="1340" Height="860" MinWidth="760" MinHeight="460"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        Background="{DynamicResource Canvas}" Foreground="{DynamicResource Ink}"
        FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="15"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True" SnapsToDevicePixels="True"
        SizeChanged="WindowResized">
    <Window.Resources>
        <Style x:Key="SidebarButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="MinHeight" Value="45"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Style.Triggers>
                <Trigger Property="Tag" Value="Collapsed">
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="Padding" Value="4,8"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource HoverSurface}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PressedSurface}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border x:Name="NavigationPane" Width="232" ClipToBounds="True"
                Background="{DynamicResource NavigationSurface}"
                BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0" Padding="8,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Button x:Name="SidebarToggle" Style="{StaticResource SidebarButton}" Margin="0,0,0,12"
                        AutomationProperties.AutomationId="SidebarToggle" Click="ToggleSidebar">
                    <ui:SymbolIcon Symbol="Navigation24" FontSize="20" Foreground="{DynamicResource Accent}"/>
                </Button>
                <ListBox x:Name="Pages" Grid.Row="1" ItemContainerStyle="{StaticResource NavItem}"
                         Background="Transparent" BorderThickness="0" Padding="0" SelectionChanged="Navigate"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Hidden"
                         AutomationProperties.Name="页面导航">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" ToolTip="{Binding Label}">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="HorizontalAlignment" Value="Left"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="Collapsed">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="20" VerticalAlignment="Center"
                                               Foreground="{DynamicResource Accent}"/>
                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" FontWeight="Medium"
                                           Margin="12,0,0,0" Visibility="{Binding Tag, RelativeSource={RelativeSource AncestorType=ListBox}}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Border x:Name="SettingsSelection" Grid.Row="2" Margin="0,8,0,0" CornerRadius="7">
                    <Button x:Name="SettingsButton" Style="{StaticResource SidebarButton}" Click="OpenSettings"
                            AutomationProperties.Name="设置" AutomationProperties.AutomationId="SettingsNavigation" ToolTip="设置">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ClipboardSettings24" FontSize="20" Foreground="{DynamicResource Accent}"/>
                            <TextBlock x:Name="SettingsLabel" Text="设置" Margin="12,0,0,0" FontWeight="Medium"/>
                        </StackPanel>
                    </Button>
                </Border>
            </Grid>
        </Border>
        <ContentControl x:Name="PageContent" Grid.Column="1" Focusable="False"
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
        <local:NotificationStack x:Name="Notifications" Grid.Column="1" Panel.ZIndex="5" Width="386"
                                 HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="12,12,18,144"/>
    </Grid>
</Window>
