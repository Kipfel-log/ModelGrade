<Window x:Class="SWGrade.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SWGrade 学生端 · 零件" Icon="Assets/SWGrade.ico"
        Width="1040" Height="820" MinWidth="730" MinHeight="580"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource Canvas}" Foreground="{DynamicResource Ink}"
        FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="15">
    <DockPanel Margin="28">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="零件专项判分" FontSize="30" FontWeight="SemiBold"/>
                <TextBlock x:Name="ConnectionStatus" Text="正在检测 SOLIDWORKS…" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,5,0,0"/>
            </StackPanel>
        </DockPanel>
        <TextBlock x:Name="Status" DockPanel.Dock="Bottom" Margin="0,10,0,0" TextWrapping="Wrap"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,10,0">
                <WrapPanel>
                    <Button Content="重新检测 SOLIDWORKS" Click="Detect"/>
                    <Button x:Name="ExportConnectionLogButton" Content="导出连接日志…" Click="ExportConnectionLog" IsEnabled="False"/>
                </WrapPanel>
                <Grid x:Name="ModelForm" IsEnabled="False" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Panel}">
                        <StackPanel>
                            <TextBlock Text="标准件" Style="{StaticResource SectionTitle}"/>
                            <TextBlock x:Name="ReferenceName" Text="请选择本题发布的零件3.SLDPRT" TextWrapping="Wrap" Margin="0,2,0,10"/>
                            <Button Content="选择标准件…" Click="PickReference" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Panel}">
                        <StackPanel>
                            <TextBlock Text="我的模型" Style="{StaticResource SectionTitle}"/>
                            <TextBlock x:Name="StudentModelName" Text="请选择已保存的学生零件" TextWrapping="Wrap" Margin="0,2,0,10"/>
                            <WrapPanel>
                                <Button Content="选择学生件…" Click="PickStudent"/>
                                <Button Content="使用 CAD 当前件" Click="UseActive"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </Grid>
                <Button x:Name="AnalyzeButton" Content="开始判分" Click="Analyze" IsEnabled="False"
                        Style="{StaticResource PrimaryButton}" Margin="0,14,0,10" HorizontalAlignment="Left"/>
                <Border x:Name="ResultPanel" Style="{StaticResource Panel}" Visibility="Collapsed" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock x:Name="Score" FontSize="27" FontWeight="SemiBold"/>
                        <TextBlock x:Name="ShellSummary" TextWrapping="Wrap" Margin="0,7,0,2"/>
                        <TextBlock x:Name="FlatSummary" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <DataGrid x:Name="Steps" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                  HeadersVisibility="Column" MaxHeight="320" GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="步骤" Binding="{Binding Step}" Width="115"/>
                                <DataGridTextColumn Header="检查项" Binding="{Binding Criterion}" Width="146"/>
                                <DataGridTextColumn Header="得分" Binding="{Binding Display}" Width="104"/>
                                <DataGridTemplateColumn Header="证据" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate><TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Margin="4"/></DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Panel}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="提交成绩" Style="{StaticResource SectionTitle}"/>
                        <WrapPanel Margin="0,6,0,6">
                            <TextBlock Text="学号" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="StudentId" Width="122" MaxLength="32" Margin="0,0,12,0"/>
                            <TextBlock Text="姓名" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="StudentName" Width="122" MaxLength="40" Margin="0,0,12,0"/>
                            <Button Content="导出成绩文件…" Click="Export"/>
                        </WrapPanel>
                        <WrapPanel Margin="0,6,0,0">
                            <TextBlock Text="教师地址" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="TeacherAddress" IsEditable="True" Width="150" Margin="0,0,8,0"/>
                            <Button Content="发现大屏" Click="FindTeacher"/>
                            <TextBlock Text="课堂码" VerticalAlignment="Center" Margin="7,0,7,0"/>
                            <TextBox x:Name="ClassCode" Width="76" MaxLength="6" Margin="0,0,8,0"/>
                            <Button Content="发送本次成绩" Click="Submit"/>
                            <Button Content="上传已导出的文件…" Click="Upload"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
