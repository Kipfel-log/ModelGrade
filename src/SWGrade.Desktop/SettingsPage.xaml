<UserControl x:Class="SWGrade.Desktop.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,20,28,28" MaxWidth="1140">
            <TextBlock Text="设置" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="调整界面外观、SOLIDWORKS 连接和本机数据的位置。" Style="{StaticResource Description}" Margin="0,6,0,22"/>

            <Border Style="{StaticResource Panel}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="外观" Style="{StaticResource SectionTitle}"/>
                    <ui:ToggleSwitch OffContent="浅色主题" OnContent="深色主题" IsChecked="{Binding Appearance.IsDark}"
                                     AutomationProperties.Name="深色主题" Margin="0,0,0,11"/>
                    <ui:ToggleSwitch OffContent="使用不透明背景" OnContent="在支持时使用 Mica" IsChecked="{Binding Appearance.PreferMica}"
                                     AutomationProperties.Name="Mica 材质" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding Appearance.MaterialState}" Style="{StaticResource Description}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Panel}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="SOLIDWORKS 连接" Style="{StaticResource SectionTitle}"/>
                    <WrapPanel Margin="0,0,0,12">
                        <Label Content="预期 CAD 版本" Target="{Binding ElementName=Versions}" Margin="0,0,8,0"/>
                        <ComboBox x:Name="Versions" MinWidth="134" Padding="8,6" Margin="0,0,12,0"
                                  ItemsSource="{Binding Connection.Versions}" SelectedItem="{Binding Connection.SelectedVersion}">
                            <ComboBox.Style>
                                <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Connection.IsBusy}" Value="True">
                                            <Setter Property="IsEnabled" Value="False"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ComboBox.Style>
                        </ComboBox>
                        <Button Content="重新检测" Command="{Binding Connection.CheckCommand}"/>
                        <TextBlock Text="{Binding Connection.State}" Foreground="{DynamicResource Accent}"
                                   VerticalAlignment="Center" Margin="4,0,0,0"/>
                    </WrapPanel>
                    <ui:InfoBar IsOpen="{Binding Connection.ShowConnectionHelp, Mode=OneWay}" IsClosable="False" Severity="Warning"
                                Title="SOLIDWORKS 目前无法用于分析" Message="{Binding Connection.ConnectionHelp}" Margin="0,0,0,12"/>
                    <Expander Header="详细诊断" IsExpanded="False">
                        <DockPanel Margin="0,12,0,0">
                            <Button DockPanel.Dock="Top" Content="导出诊断…" Command="{Binding Connection.ExportCommand}"
                                    HorizontalAlignment="Left" Margin="0,0,0,9"/>
                            <ListBox ItemsSource="{Binding Connection.Lines}" MaxHeight="330"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="3,5"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Expander>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Panel}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="打开目录" Command="{Binding OpenFolderCommand}" Margin="10,0,0,0"/>
                    <StackPanel>
                        <TextBlock Text="本机数据" Style="{StaticResource SectionTitle}" Margin="0,0,0,2"/>
                        <TextBlock Text="作业和批改历史保存在本机。" Style="{StaticResource Description}"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
