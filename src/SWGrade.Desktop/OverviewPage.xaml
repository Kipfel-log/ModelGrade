<UserControl x:Class="SWGrade.Desktop.OverviewPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <UserControl.Resources>
        <Style x:Key="Metric" TargetType="Border" BasedOn="{StaticResource Panel}">
            <Setter Property="MinHeight" Value="126"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
        <Style x:Key="MetricValue" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,7,0,0"/>
        </Style>
    </UserControl.Resources>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="Dashboard" Margin="28,20,28,28" MaxWidth="1320" SizeChanged="DashboardResized">
            <DockPanel Margin="0,0,0,22">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="14,2,0,0">
                    <Border Background="{DynamicResource AccentSoft}" CornerRadius="7" Padding="12,8"
                            Margin="0,0,9,0" VerticalAlignment="Top">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="PlugConnected24" FontSize="17" Foreground="{DynamicResource Accent}" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding Connection.State}" Foreground="{DynamicResource Accent}"
                                       FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <StackPanel>
                        <Button AutomationProperties.AutomationId="DetectEnvironment" Content="立即检测"
                                ToolTip="检查本机环境、CAD 安装和当前 SOLIDWORKS 连接"
                                Command="{Binding Connection.CheckCommand}" Margin="0"/>
                        <ProgressBar IsIndeterminate="True" Margin="0,6,0,0" AutomationProperties.Name="正在检测环境">
                            <ProgressBar.Visibility>
                                <Binding Path="Connection.IsBusy">
                                    <Binding.Converter>
                                        <BooleanToVisibilityConverter/>
                                    </Binding.Converter>
                                </Binding>
                            </ProgressBar.Visibility>
                        </ProgressBar>
                    </StackPanel>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="概览" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="管理模型分析、作业和本机批改记录。" Style="{StaticResource Description}"/>
                </StackPanel>
            </DockPanel>

            <UniformGrid x:Name="Metrics" Columns="4" Margin="0,0,-12,6">
                <Border Style="{StaticResource Metric}">
                    <StackPanel>
                        <ui:SymbolIcon Symbol="PlugConnected24" FontSize="20" Foreground="{DynamicResource Accent}" HorizontalAlignment="Left"/>
                        <TextBlock Text="SOLIDWORKS 连接" Style="{StaticResource Description}"/>
                        <TextBlock Text="{Binding Connection.State}" Style="{StaticResource MetricValue}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Metric}">
                    <StackPanel>
                        <ui:SymbolIcon Symbol="CubeMultiple24" FontSize="20" Foreground="{DynamicResource Accent}" HorizontalAlignment="Left"/>
                        <TextBlock Text="当前 CAD 连接" Style="{StaticResource Description}"/>
                        <TextBlock Text="{Binding Connection.DetectedVersion}" Style="{StaticResource MetricValue}"/>
                        <TextBlock Text="{Binding Connection.InstallationSummary}" FontSize="13" Foreground="{DynamicResource Muted}"
                                   TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Metric}">
                    <StackPanel>
                        <ui:SymbolIcon Symbol="Window24" FontSize="20" Foreground="{DynamicResource Accent}" HorizontalAlignment="Left"/>
                        <TextBlock Text="系统环境" Style="{StaticResource Description}"/>
                        <TextBlock Text="{Binding Connection.EnvironmentSummary}" Style="{StaticResource MetricValue}"/>
                        <TextBlock Text="{Binding Connection.FrameworkSummary}" FontSize="13" Foreground="{DynamicResource Muted}"
                                   TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Metric}">
                    <StackPanel>
                        <ui:SymbolIcon Symbol="ClipboardClock24" FontSize="20" Foreground="{DynamicResource Accent}" HorizontalAlignment="Left"/>
                        <TextBlock Text="最近批改" Style="{StaticResource Description}"/>
                        <TextBlock Text="{Binding History.LatestStatus}" Style="{StaticResource MetricValue}"/>
                        <TextBlock Text="{Binding History.LatestLabel}" Foreground="{DynamicResource Muted}" FontSize="13"
                                   TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <DockPanel Margin="0,0,0,16">
                <DockPanel.Style>
                    <Style TargetType="DockPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Connection.ShowConnectionHelp}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DockPanel.Style>
                <Button DockPanel.Dock="Right" Content="连接设置" Command="{Binding SettingsCommand}" Margin="12,0,0,0"/>
                <TextBlock Text="请确认 SOLIDWORKS 主窗口与许可证可用，再重新检测。" Style="{StaticResource Description}" Margin="0"
                           VerticalAlignment="Center"/>
            </DockPanel>

            <TextBlock Text="开始工作" Style="{StaticResource SectionTitle}"/>
            <UniformGrid x:Name="Actions" Columns="3" Margin="0,0,-12,12">
                <Border Style="{StaticResource Panel}" Padding="17" Margin="0,0,12,12">
                    <DockPanel>
                        <ui:SymbolIcon DockPanel.Dock="Top" Symbol="ArrowImport24" FontSize="22"
                                       HorizontalAlignment="Left" Foreground="{DynamicResource Accent}" Margin="0,0,0,9"/>
                        <Button DockPanel.Dock="Bottom" Content="导入标准模型…" Command="{Binding ImportReferenceCommand}"
                                HorizontalAlignment="Left" Margin="0,13,0,0"/>
                        <TextBlock Text="选择一个参考零件，与当前模型对照。" TextWrapping="Wrap"/>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Panel}" Padding="17" Margin="0,0,12,12">
                    <DockPanel>
                        <ui:SymbolIcon DockPanel.Dock="Top" Symbol="FolderOpen24" FontSize="22"
                                       HorizontalAlignment="Left" Foreground="{DynamicResource Accent}" Margin="0,0,0,9"/>
                        <Button DockPanel.Dock="Bottom" Content="导入学生模型…" Command="{Binding ImportStudentCommand}"
                                HorizontalAlignment="Left" Margin="0,13,0,0"/>
                        <TextBlock Text="把学生提交加入作业的批改队列。" TextWrapping="Wrap"/>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Panel}" Padding="17" Margin="0,0,12,12">
                    <DockPanel>
                        <ui:SymbolIcon DockPanel.Dock="Top" Symbol="PlayCircle24" FontSize="22"
                                       HorizontalAlignment="Left" Foreground="{DynamicResource Accent}" Margin="0,0,0,9"/>
                        <Button DockPanel.Dock="Bottom" Content="开始模型分析" Command="{Binding AnalyzeCommand}"
                                Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,13,0,0"/>
                        <TextBlock Text="分析当前件，查看数值和三维模型。" TextWrapping="Wrap"/>
                    </DockPanel>
                </Border>
            </UniformGrid>

            <Border Style="{StaticResource Panel}" MinHeight="154">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Content="查看批改记录" Command="{Binding OpenRecordsCommand}" Margin="8,0,0,0"/>
                        <TextBlock Text="最近任务" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="0"/>
                    </DockPanel>
                    <TextBlock Text="本机记录暂不可用。可在批改记录页重新读取。" TextWrapping="Wrap"
                               Foreground="{DynamicResource Muted}" Margin="0,0,0,8">
                        <TextBlock.Visibility>
                            <Binding Path="History.HasError">
                                <Binding.Converter><BooleanToVisibilityConverter/></Binding.Converter>
                            </Binding>
                        </TextBlock.Visibility>
                    </TextBlock>
                    <TextBlock Text="正在读取本机批改记录…" Foreground="{DynamicResource Muted}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding History.IsLoading}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="还没有批改记录。创建作业并运行一次批改后，任务会显示在这里。"
                               Style="{StaticResource Description}">
                        <TextBlock.Visibility>
                            <Binding Path="History.IsEmpty">
                                <Binding.Converter>
                                    <BooleanToVisibilityConverter/>
                                </Binding.Converter>
                            </Binding>
                        </TextBlock.Visibility>
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding History.Recent}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="104"/>
                                            <ColumnDefinition Width="110"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,12,0">
                                            <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding AssignmentName}" Foreground="{DynamicResource Muted}" FontSize="13" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding DisplayTime}" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
