<Window x:Class="SWGrade.Teacher.ClassroomWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SWGrade 教师大屏" WindowState="Maximized"
        MinWidth="760" MinHeight="540" Background="#0B1322" Foreground="#F1F5FC"
        FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="16" KeyDown="OnKeyDown">
    <Window.Resources>
        <SolidColorBrush x:Key="Surface" Color="#132039"/>
        <SolidColorBrush x:Key="Border" Color="#30405E"/>
        <SolidColorBrush x:Key="Muted" Color="#AFC2DE"/>
        <SolidColorBrush x:Key="Blue" Color="#62A5FA"/>
        <SolidColorBrush x:Key="Gold" Color="#F3C270"/>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="18,14"/>
        </Style>
        <Style x:Key="Metric" TargetType="TextBlock">
            <Setter Property="FontSize" Value="36"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Face" CornerRadius="7" Padding="13,8"
                                Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Background" Value="#253C60"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="{StaticResource Blue}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="#F1F5FC"/>
            <Setter Property="Margin" Value="7,0,0,0"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#F1F5FC"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabFace" Background="Transparent" BorderThickness="0,0,0,3" BorderBrush="Transparent" Padding="16,7">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="TabFace" Property="BorderBrush" Value="{StaticResource Blue}"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TabFace" Property="Background" Value="#253C60"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <DockPanel Margin="28,20" TextElement.Foreground="#F1F5FC">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,10,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="导入成绩文件…" Click="ImportFiles"/>
                    <Button x:Name="FullscreenButton" Content="全屏" Click="ToggleFullscreen"/>
                </StackPanel>
                <TextBlock Text="课堂成绩" FontSize="34" FontWeight="SemiBold"/>
            </DockPanel>
            <WrapPanel Margin="0,6,0,0">
                <TextBlock x:Name="ClassroomCode" Foreground="{StaticResource Blue}" FontWeight="SemiBold" Margin="0,0,18,0"/>
                <TextBlock x:Name="Connection" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
            </WrapPanel>
        </StackPanel>
        <TextBlock x:Name="Feedback" DockPanel.Dock="Bottom" Margin="0,8,0,0" TextWrapping="Wrap" Style="{StaticResource Caption}"/>
        <TabControl Background="Transparent" BorderThickness="0" Foreground="#F1F5FC" Padding="0,10,0,0"
                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
            <TabItem Header="课堂统计">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,10,12">
                        <UniformGrid Columns="4" Margin="0,0,-10,12">
                            <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                                <StackPanel><TextBlock Text="已提交" Style="{StaticResource Caption}"/><TextBlock x:Name="ReceivedCount" Style="{StaticResource Metric}"/></StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                                <StackPanel><TextBlock Text="完整成绩平均分" Style="{StaticResource Caption}"/><TextBlock x:Name="Average" Style="{StaticResource Metric}"/></StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                                <StackPanel><TextBlock Text="完整成绩最高分" Style="{StaticResource Caption}"/><TextBlock x:Name="Best" Style="{StaticResource Metric}"/></StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                                <StackPanel><TextBlock Text="待复核人数" Style="{StaticResource Caption}"/><TextBlock x:Name="Pending" Style="{StaticResource Metric}" Foreground="{StaticResource Gold}"/></StackPanel>
                            </Border>
                        </UniformGrid>
                        <UniformGrid Columns="2">
                            <Border Style="{StaticResource Card}" VerticalAlignment="Top" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="成绩分布" FontSize="23" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="DistributionState" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,3,0,7"/>
                                    <WrapPanel Margin="0,0,0,8">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                                            <Border Width="10" Height="10" Background="{StaticResource Blue}" CornerRadius="2" Margin="0,0,6,0"/>
                                            <TextBlock Text="完整成绩" Foreground="{StaticResource Blue}" FontSize="14"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="10" Height="10" Background="{StaticResource Gold}" CornerRadius="2" Margin="0,0,6,0"/>
                                            <TextBlock Text="待复核" Foreground="{StaticResource Gold}" FontSize="14"/>
                                        </StackPanel>
                                    </WrapPanel>
                                    <ItemsControl x:Name="Distribution">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="5"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel ToolTip="{Binding Description}" AutomationProperties.Name="{Binding Description}">
                                                    <Grid Height="177">
                                                        <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                                            <TextBlock Text="{Binding Count}" FontWeight="SemiBold" FontSize="21" HorizontalAlignment="Center"/>
                                                            <Border Height="{Binding PendingHeight}" Width="34" Background="{StaticResource Gold}"/>
                                                            <Border Height="{Binding FinalHeight}" Width="34" Background="{StaticResource Blue}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                    <Border BorderThickness="0,1,0,0" BorderBrush="{StaticResource Border}" Padding="0,6,0,0">
                                                        <TextBlock Text="{Binding Range}" FontSize="14" HorizontalAlignment="Center"/>
                                                    </Border>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" VerticalAlignment="Top" Margin="6,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="各步骤扣分" FontSize="23" FontWeight="SemiBold"/>
                                    <TextBlock Text="柱长表示该步骤扣分人数占已提交人数的比例" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,3,0,12"/>
                                    <TextBlock x:Name="BreakdownState" Style="{StaticResource Caption}" Margin="0,8"/>
                                    <ItemsControl x:Name="Breakdown">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,0,0,10">
                                                    <DockPanel Margin="0,0,0,4">
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Description}" Style="{StaticResource Caption}"/>
                                                        <TextBlock Text="{Binding Step}" FontWeight="SemiBold"/>
                                                    </DockPanel>
                                                    <ProgressBar Value="{Binding Share, Mode=OneWay}" Maximum="1" Height="8">
                                                        <ProgressBar.Template>
                                                            <ControlTemplate TargetType="ProgressBar">
                                                                <Border x:Name="PART_Track" Background="#25334B" CornerRadius="4">
                                                                    <Border x:Name="PART_Indicator" Background="{StaticResource Gold}" CornerRadius="4" HorizontalAlignment="Left"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </ProgressBar.Template>
                                                    </ProgressBar>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="提交明细" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                <DataGrid x:Name="Scores" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          RowHeight="48" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource Border}"
                          Background="{StaticResource Surface}" RowBackground="{StaticResource Surface}" AlternatingRowBackground="#172741"
                          Foreground="#F1F5FC" BorderBrush="{StaticResource Border}" FontSize="19" SelectionUnit="FullRow"
                          SelectionMode="Single" RowDetailsVisibilityMode="VisibleWhenSelected"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#213656"/><Setter Property="Foreground" Value="#F1F5FC"/>
                            <Setter Property="Padding" Value="10,8"/>
                        </Style>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Background="{TemplateBinding Background}" Padding="10,0">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#294C78"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                        <Style x:Key="ScoreCellText" TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="学号" Binding="{Binding Report.StudentId}" Width="1.1*" MinWidth="96" ElementStyle="{StaticResource ScoreCellText}"/>
                        <DataGridTextColumn Header="姓名" Binding="{Binding Report.StudentName}" Width="1*" MinWidth="106" ElementStyle="{StaticResource ScoreCellText}"/>
                        <DataGridTextColumn Header="总分" Binding="{Binding Report.Score}" Width="1.6*" MinWidth="188" ElementStyle="{StaticResource ScoreCellText}"/>
                        <DataGridTextColumn Header="扣分" Binding="{Binding Deductions}" Width=".7*" MinWidth="64" ElementStyle="{StaticResource ScoreCellText}"/>
                        <DataGridTextColumn Header="接收时间" Binding="{Binding Received, StringFormat=HH:mm:ss}" Width="1*" MinWidth="116" ElementStyle="{StaticResource ScoreCellText}"/>
                    </DataGrid.Columns>
                    <DataGrid.RowDetailsTemplate>
                        <DataTemplate>
                            <StackPanel Margin="12" TextElement.Foreground="#F1F5FC">
                                <TextBlock Text="{Binding Report.ModelName}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <ItemsControl ItemsSource="{Binding Issues}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock TextWrapping="Wrap" FontSize="15" Margin="0,0,0,5">
                                                <Run Text="{Binding Step, Mode=OneWay}"/><Run Text=" · "/>
                                                <Run Text="{Binding Criterion, Mode=OneWay}"/><Run Text=" · "/>
                                                <Run Text="{Binding Display, Mode=OneWay}"/><Run Text=" · "/>
                                                <Run Text="{Binding Detail, Mode=OneWay}"/>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </DataGrid.RowDetailsTemplate>
                </DataGrid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
